<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <!-- AuthCheckDatabase.cs (dùng chung) có nhánh InMemory nên cần gói này để biên dịch; bộ kiểm tra này chỉ chạy SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dùng lại fixture tạo/dọn database SQL thử riêng (tên ngẫu nhiên) của bộ kiểm tra auth. -->
    <Compile Include="..\CyberManagement.API.Checks\AuthCheckDatabase.cs" Link="AuthCheckDatabase.cs" />
    <ProjectReference Include="..\..\src\CyberManagement.API\CyberManagement.API.csproj" />
  </ItemGroup>

</Project>
