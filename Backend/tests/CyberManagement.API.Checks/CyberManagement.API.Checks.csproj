<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CyberManagement.Application/CyberManagement.Application.csproj" />
    <!-- Biên dịch trực tiếp mã HTTP để kiểm tra API độc lập khi Infrastructure còn lỗi cũ. -->
    <Compile Include="../../CyberManagement.API/Controller/*.cs" Link="Api/Controller/%(Filename)%(Extension)" />
    <Compile Include="../../CyberManagement.API/Security/*.cs" Link="Api/Security/%(Filename)%(Extension)" />
    <Compile Include="../../CyberManagement.API/ExceptionHandling/*.cs" Link="Api/ExceptionHandling/%(Filename)%(Extension)" />
    <Compile Include="../../CyberManagement.API/ApiDependencyInjection.cs" Link="Api/ApiDependencyInjection.cs" />
  </ItemGroup>
</Project>
