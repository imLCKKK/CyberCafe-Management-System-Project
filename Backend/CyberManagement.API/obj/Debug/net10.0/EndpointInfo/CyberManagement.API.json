  "components": {
    "schemas": {
      "CreateInventoryMovementRequest": {
        "required": [
          "reason",
          "type"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "maximum": 9223372036854775807,
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "minLength": 1,
            "pattern": "^(Receive|Adjust)$",
            "type": "string"
          },
          "quantityDelta": {
            "maximum": 1000000,
            "minimum": -1000000,
            "type": "integer",
            "format": "int32"
          },
          "reason": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DevLoginRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "employeeId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "customerId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
